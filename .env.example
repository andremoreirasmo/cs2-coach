# Copie este arquivo para ".env" e preencha. NUNCA compartilhe o .env.

# --- FACEIT (developers.faceit.com > App Studio > API Keys > Server side)
FACEIT_API_KEY=
FACEIT_NICKNAME=
# Opcional: token da Downloads API (precisa pedir acesso a FACEIT, ~30 dias).
# Sem ele, baixe a demo na sala da partida e o programa pega da pasta Downloads.
FACEIT_DOWNLOADS_TOKEN=

# --- Steam (Premier/Competitivo)
# Chave: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# Seu SteamID64 (17 digitos). Se vazio, e aprendido automaticamente pelo GSI.
STEAM_ID64=
# Codigo de autenticacao do historico: https://help.steampowered.com/pt-br/wizard/HelpWithGameIssue/?appid=730&issueid=128
STEAM_AUTH_CODE=
# Share code da sua partida mais antiga que voce quer como ponto de partida (CSGO-xxxxx-...)
STEAM_LAST_SHARECODE=

# --- Opcional
GSI_PORT=31982
# Pastas extras a monitorar por demos, separadas por ;
EXTRA_DEMO_DIRS=
